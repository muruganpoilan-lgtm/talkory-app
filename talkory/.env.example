# Copy to .env and fill in. Never commit .env.
DOMAIN=api.yourdomain.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-64-random-chars
OTP_DEV_MODE=false

AGORA_APP_ID=
AGORA_APP_CERT=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio Verify (SMS login). Console > Verify > Services > create one, copy its Service SID (starts with VA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# Error monitoring (sentry.io > create a Node project, copy its DSN). Leave empty to disable.
SENTRY_DSN=
# iOS VoIP ring (see IOS_VOIP.md). Leave empty to skip; iPhones then get a normal notification.
APNS_KEY_PATH=/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
