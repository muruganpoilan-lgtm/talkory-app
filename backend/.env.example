PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talkory
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
AGORA_APP_ID=
AGORA_APP_CERT=
OTP_DEV_MODE=true
MIN_CALL_SECONDS=60
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Firebase Cloud Messaging (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Twilio Verify (SMS login). Console > Verify > Services > create one, copy its Service SID (starts with VA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# India SMS (MSG91). When both are set they are used instead of Twilio.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# India SMS (apitxt.com). If APITXT_AUTH_KEY is set it is used first.
APITXT_AUTH_KEY=
APITXT_TEMPLATE_ID=
APITXT_CHANNEL=

# Error monitoring (sentry.io > create a Node project, copy its DSN). Leave empty to disable.
SENTRY_DSN=
# iOS VoIP ring (see IOS_VOIP.md). Leave empty to skip; iPhones then get a normal notification.
APNS_KEY_PATH=/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# Payout invoices (optional): shown on the PDF invoice. GST is 18% unless changed.
# COMPANY_ADDRESS=105A, Green groov, Jeyam Nagar, Kanchivakkam, Sriperumbudur, Chennai - 601301, India
# COMPANY_GSTIN=
# PAYOUT_GST_PERCENT=18
