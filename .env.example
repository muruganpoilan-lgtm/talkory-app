# Copy to .env and fill in. Never commit .env.
DOMAIN=api.yourdomain.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-64-random-chars
OTP_DEV_MODE=false

AGORA_APP_ID=
AGORA_APP_CERT=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Automatic UPI payouts (RazorpayX). Leave AUTO_PAYOUTS empty to keep manual payouts.
AUTO_PAYOUTS=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Twilio Verify (SMS login). Console > Verify > Services > create one, copy its Service SID (starts with VA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# India SMS (MSG91). When both are set they are used instead of Twilio.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Error monitoring (sentry.io > create a Node project, copy its DSN). Leave empty to disable.
SENTRY_DSN=
# iOS VoIP ring (see IOS_VOIP.md). Leave empty to skip; iPhones then get a normal notification.
APNS_KEY_PATH=/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
# AI-generated photo check (sightengine.com). Leave empty to skip the check.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
# Name shown in the partner agreement
COMPANY_NAME=
